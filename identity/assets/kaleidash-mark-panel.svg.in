<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" role="img" aria-labelledby="title desc">
  <title id="title">KaleidashOS panel mark</title>
  <desc id="desc">A bold kinetic K optimized for small panel sizes.</desc>
  <defs>
    <linearGradient id="panel-accent" x1="5" y1="5" x2="28" y2="27" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="{{ colors.tertiary.default.hex }}"/>
      <stop offset="0.5" stop-color="{{ colors.primary.default.hex }}"/>
      <stop offset="1" stop-color="{{ colors.secondary.default.hex }}"/>
    </linearGradient>
  </defs>
  <path fill="{{ colors.surface.default.hex }}" stroke="{{ colors.on_surface.default.hex }}" stroke-width="1.35" stroke-linejoin="round" d="M7.2 3.3h7.2l-1.7 9.5L25 3.8h3.1L17.3 15.4 29 28.3h-8.4l-8.8-9.1-1.6 9.5H3.4Z"/>
  <path fill="url(#panel-accent)" d="m12.2 13.8 7.1-5.1-5.8 7 6.7 7.1-8-5.4Z"/>
</svg>
