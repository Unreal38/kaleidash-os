#!/usr/bin/env python3
import re
import sys
from pathlib import Path


def encode(value: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9._-]+", value):
        return value
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main() -> int:
    if len(sys.argv) != 4:
        print("usage: generate-os-release SOURCE OUTPUT VERSION_ID", file=sys.stderr)
        return 2

    source_path = Path(sys.argv[1])
    output_path = Path(sys.argv[2])
    version_id = sys.argv[3]
    updates = {
        "NAME": "KaleidashOS",
        "PRETTY_NAME": f"KaleidashOS {version_id} (Fedora-based)",
        "ID": "kaleidash",
        "ID_LIKE": "fedora",
        "VERSION": f"{version_id} (KaleidashOS)",
        "VERSION_ID": version_id,
        "VARIANT": "KaleidashOS Desktop",
        "VARIANT_ID": "kaleidash",
        "ANSI_COLOR": "0;35",
        "LOGO": "kaleidash",
        "HOME_URL": "https://github.com/Unreal38/kaleidash-os",
        "DOCUMENTATION_URL": "https://github.com/Unreal38/kaleidash-os",
        "SUPPORT_URL": "https://github.com/Unreal38/kaleidash-os/issues",
        "BUG_REPORT_URL": "https://github.com/Unreal38/kaleidash-os/issues",
    }

    lines = source_path.read_text(encoding="utf-8").splitlines()
    seen: set[str] = set()
    result: list[str] = []

    for line in lines:
        match = re.match(r"^([A-Z][A-Z0-9_]*)=", line)
        if match and match.group(1) in updates:
            key = match.group(1)
            result.append(f"{key}={encode(updates[key])}")
            seen.add(key)
        else:
            result.append(line)

    for key, value in updates.items():
        if key not in seen:
            result.append(f"{key}={encode(value)}")

    output_path.write_text("\n".join(result) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
