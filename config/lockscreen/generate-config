#!/usr/bin/env python3
"""Generate a Noctalia lock-screen layout for the connected Niri outputs."""

from __future__ import annotations

import json
import sys
from pathlib import Path
from typing import Any, NoReturn


def fail(message: str) -> NoReturn:
    raise SystemExit(f"KaleidashOS lock-screen generator: {message}")


def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def read_outputs(path: Path) -> list[tuple[str, float, float]]:
    try:
        payload: Any = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read Niri output data: {error}")

    if isinstance(payload, dict):
        records = list(payload.items())
    elif isinstance(payload, list):
        records = [(str(index), value) for index, value in enumerate(payload)]
    else:
        fail("Niri output data must be an object or array")

    outputs: list[tuple[str, float, float]] = []
    for fallback_name, record in records:
        if not isinstance(record, dict):
            continue
        name = record.get("name", fallback_name)
        logical = record.get("logical")
        if not isinstance(name, str) or not name or not isinstance(logical, dict):
            continue
        width = logical.get("width")
        height = logical.get("height")
        if not isinstance(width, (int, float)) or not isinstance(height, (int, float)):
            continue
        if width <= 0 or height <= 0:
            continue
        outputs.append((name, float(width), float(height)))

    if not outputs:
        fail("no connected output with logical dimensions was found")
    return sorted(outputs, key=lambda output: output[0])


def widget_table(widget_id: str) -> str:
    return f'[lockscreen_widgets.widget.{toml_string(widget_id)}]'


def widget_settings_table(widget_id: str) -> str:
    return f'[lockscreen_widgets.widget.{toml_string(widget_id)}.settings]'


def render(outputs: list[tuple[str, float, float]], logo_path: Path) -> str:
    lines = [
        "# Generated by KaleidashOS. Re-run config/lockscreen/install.sh after changing outputs.",
        "",
        "[lockscreen]",
        "enabled = true",
        "lock_before_suspend = true",
        "blurred_desktop = false",
        "blur_intensity = 0.70",
        "tint_intensity = 0.30",
        'wallpaper = ""',
        "monitors = []",
        "",
        "[lockscreen_widgets]",
        "enabled = true",
        "schema_version = 2",
    ]

    for name, width, height in outputs:
        logo_id = f"kaleidash-logo@{name}"
        login_id = f"lockscreen-login-box@{name}"
        logo_size = min(240.0, max(170.0, min(width, height) * 0.16))
        login_width = min(400.0, max(320.0, width * 0.40))

        lines.extend(
            [
                "",
                widget_table(logo_id),
                'type = "sticker"',
                f"output = {toml_string(name)}",
                f"cx = {width * 0.5:.1f}",
                f"cy = {height * 0.35:.1f}",
                f"box_width = {logo_size:.1f}",
                f"box_height = {logo_size:.1f}",
                "rotation = 0.0",
                "",
                widget_settings_table(logo_id),
                f"image_path = {toml_string(str(logo_path))}",
                "opacity = 1.0",
                "",
                widget_table(login_id),
                'type = "login_box"',
                f"output = {toml_string(name)}",
                f"cx = {width * 0.5:.1f}",
                f"cy = {height * 0.59:.1f}",
                f"box_width = {login_width:.1f}",
                "box_height = 96.0",
                "rotation = 0.0",
                "",
                widget_settings_table(login_id),
                'layout = "compact"',
                "show_session_buttons = false",
                "show_media = false",
                "show_weather = false",
                "show_login_button = true",
                "show_unlock_hint = true",
                "show_caps_lock = true",
                "show_keyboard_layout = false",
                'background_color = "surface_variant"',
                "background_opacity = 0.84",
                "background_radius = 22.0",
                "input_opacity = 0.94",
                "input_radius = 14.0",
                "center_password_text = true",
            ]
        )

    return "\n".join(lines) + "\n"


def main() -> None:
    if len(sys.argv) != 4:
        fail("usage: generate-config NIRI_OUTPUTS_JSON LOGO_PATH OUTPUT_TOML")

    outputs_path = Path(sys.argv[1])
    logo_path = Path(sys.argv[2]).expanduser()
    destination = Path(sys.argv[3])
    if not logo_path.is_absolute():
        fail("logo path must be absolute")

    destination.write_text(render(read_outputs(outputs_path), logo_path), encoding="utf-8")


if __name__ == "__main__":
    main()
