#!/usr/bin/env python3
"""Validate that a captured KaleidashOS configuration snapshot is publishable."""

from __future__ import annotations

import hashlib
import re
import stat
import sys
from pathlib import Path


MAX_FILE_SIZE = 1024 * 1024
FORBIDDEN_PATH_PARTS = {
    ".gnupg",
    ".ssh",
    "cookies",
    "credentials",
    "fish_history",
    "keyrings",
    "known_hosts",
    "login-data",
    "secrets",
}
CONTENT_RULES = (
    ("private-key material", re.compile(r"BEGIN [A-Z ]*PRIVATE KEY")),
    ("unredacted home path", re.compile(r"(?:/home/|/Users/)[^\s\"']+")),
    ("embedded URL credentials", re.compile(r"[a-z][a-z0-9+.-]*://[^/@\s:]+:[^/@\s]+@", re.I)),
    ("email address", re.compile(r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b", re.I)),
)
CREDENTIAL_ASSIGNMENT = re.compile(
    r"(?im)^\s*[\"']?(?:password|passwd|token|secret|api[-_]?key|client[-_]?secret|"
    r"refresh[-_]?token|authorization|cookie|username)[\"']?\s*[:=]\s*(.*?)\s*(?:#.*)?$"
)
SAFE_CREDENTIAL_VALUES = {
    "",
    "''",
    '\"\"',
    "@USER@",
    "'@USER@'",
    '\"@USER@\"',
    "@REDACTED@",
    "'@REDACTED@'",
    '\"@REDACTED@\"',
}


def safe_credential_value(value: str) -> bool:
    compact = value.strip().removesuffix(",").strip()
    if compact in SAFE_CREDENTIAL_VALUES:
        return True
    unquoted = compact.strip("\"'")
    return re.fullmatch(r"@SECRET_[A-Z0-9_]+@", unquoted) is not None


def fail(messages: list[str]) -> None:
    for message in messages:
        print(f"KaleidashOS config validation error: {message}", file=sys.stderr)
    raise SystemExit(1)


def digest(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(65536), b""):
            value.update(chunk)
    return value.hexdigest()


def main() -> None:
    args = sys.argv[1:]
    no_manifest = False
    if "--no-manifest" in args:
        args.remove("--no-manifest")
        no_manifest = True
    if len(args) != 1:
        raise SystemExit("usage: validate-snapshot [--no-manifest] SNAPSHOT_DIRECTORY")

    root = Path(args[0]).resolve()
    if not root.is_dir():
        fail([f"snapshot directory does not exist: {root}"])

    errors: list[str] = []
    files: dict[str, Path] = {}
    for path in sorted(root.rglob("*")):
        relative = path.relative_to(root).as_posix()
        if path.is_symlink():
            errors.append(f"symbolic links are not allowed: {relative}")
            continue
        if not path.is_file():
            continue
        if relative == "manifest.tsv":
            continue
        files[relative] = path

        lowered = {part.lower() for part in path.relative_to(root).parts}
        forbidden = sorted(lowered & FORBIDDEN_PATH_PARTS)
        if forbidden:
            errors.append(f"forbidden path component {forbidden[0]!r}: {relative}")
        if path.stat().st_size > MAX_FILE_SIZE:
            errors.append(f"file exceeds 1 MiB: {relative}")
            continue
        try:
            content = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            errors.append(f"non-UTF-8 or binary file: {relative}")
            continue
        for label, pattern in CONTENT_RULES:
            match = pattern.search(content)
            if match:
                line = content.count("\n", 0, match.start()) + 1
                errors.append(f"{label} in {relative}:{line}")
        for match in CREDENTIAL_ASSIGNMENT.finditer(content):
            if not safe_credential_value(match.group(1)):
                line = content.count("\n", 0, match.start()) + 1
                errors.append(f"credential-like assignment in {relative}:{line}")

    if errors:
        fail(errors)

    if no_manifest:
        print("KaleidashOS configuration snapshot content is safe to stage.")
        return

    manifest_path = root / "manifest.tsv"
    if not manifest_path.is_file():
        fail(["manifest.tsv is missing"])

    expected: dict[str, tuple[str, str]] = {}
    lines = manifest_path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != "mode\tsha256\tpath":
        fail(["manifest.tsv has an invalid header"])
    for number, line in enumerate(lines[1:], 2):
        fields = line.split("\t")
        if len(fields) != 3:
            errors.append(f"manifest.tsv:{number} does not have three columns")
            continue
        mode, sha256, relative = fields
        expected[relative] = (mode, sha256)

    if set(expected) != set(files):
        missing = sorted(set(files) - set(expected))
        stale = sorted(set(expected) - set(files))
        errors.extend(f"manifest is missing {path}" for path in missing)
        errors.extend(f"manifest references absent {path}" for path in stale)

    for relative in sorted(set(expected) & set(files)):
        path = files[relative]
        actual_mode = format(stat.S_IMODE(path.stat().st_mode), "o")
        expected_mode, expected_digest = expected[relative]
        if actual_mode != expected_mode:
            errors.append(f"mode mismatch for {relative}: {actual_mode} != {expected_mode}")
        if digest(path) != expected_digest:
            errors.append(f"checksum mismatch for {relative}")

    if errors:
        fail(errors)
    print(f"KaleidashOS configuration snapshot is valid ({len(files)} files).")


if __name__ == "__main__":
    main()
